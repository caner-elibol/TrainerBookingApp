# Copy this file to `.env` in the same folder (`.env` is gitignored).
# docker compose reads `.env` automatically.

# --- Database ---
POSTGRES_PASSWORD=devpassword

# --- JWT (required) ---
# At least 32 random bytes, base64. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=

# --- Email (optional) ---
# Gmail address with 2FA enabled, plus a 16-character App Password
# (Google Account -> Security -> App passwords), not the normal account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Set to "false" to send real emails; "true" only logs them.
EMAIL_USE_FAKE_SENDER=true

# --- PayTR (optional) ---
# Leave PAYTR_USE_FAKE_GATEWAY=true until real merchant credentials are available.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_USE_FAKE_GATEWAY=true
